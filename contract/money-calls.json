    {
      "name": "creates a static account with KYC and metadata",
      "call": "virtualAccounts.create",
      "idempotencyKey": "key-123",
      "args": {
        "provider": "VFD",
        "accountType": "STATIC",
        "customer": {
          "reference": "cust-1", "firstName": "Ada", "lastName": "Okafor", "email": "ada@example.com",
          "phone": "+2348012345678", "bvn": "12345678901", "dateOfBirth": "1990-01-01"
        },
        "metadata": { "source": "console" }
      },
      "script": [
        {
          "status": 201,
          "body": {
            "responseCode": "09", "responseMessage": "Virtual account created successfully",
            "data": {
              "id": "va-1", "provider": "VFD", "account_type": "STATIC", "currency": "NGN",
              "account_number": "1000000001", "account_name": "Ada Okafor", "bank_name": "VFD",
              "bank_code": "090110", "customer_reference": "cust-1", "status": "ACTIVE"
            }
          }
        }
      ],
      "requests": [
        {
          "method": "POST",
          "path": "/api/v1/virtual-accounts",
          "headers": { "Idempotency-Key": "key-123", "Authorization": "Bearer t1" },
          "body": {
            "provider": "VFD", "accountType": "STATIC", "currency": "NGN",
            "customer": {
              "reference": "cust-1", "firstName": "Ada", "lastName": "Okafor", "email": "ada@example.com",
              "phone": "+2348012345678", "bvn": "12345678901", "dateOfBirth": "1990-01-01"
            },
            "metadata": { "source": "console" }
          }
        }
      ],
      "result": {
        "id": "va-1", "accountNumber": "1000000001", "accountName": "Ada Okafor", "bankName": "VFD",
        "bankCode": "090110", "customerReference": "cust-1", "accountType": "STATIC", "status": "ACTIVE",
        "isIdempotentReplay": false, "expectedAmount": null
      }
    },
